# --- Core ---
ENV=development

# --- Database ---
# POSTGRES_USER/PASSWORD is the cluster's bootstrap/owner role (a Postgres
# superuser by Postgres's own design) — used for migrations/admin only as
# of Phase 17B-1, via DATABASE_MIGRATION_URL below. It is NOT the
# application's normal runtime connection anymore.
POSTGRES_USER=klaros
POSTGRES_PASSWORD=klaros
POSTGRES_DB=klaros
# Phase 17B-1: the restricted runtime application role (LOGIN,
# NOSUPERUSER, NOBYPASSRLS, never a table owner — see
# backend/scripts/db/provision_app_role.py). DATABASE_URL below connects
# as this role; only DATABASE_MIGRATION_URL uses POSTGRES_USER.
APP_DB_USER=klaros_app
APP_DB_PASSWORD=klaros_app
DATABASE_URL=postgresql+asyncpg://klaros_app:klaros_app@postgres:5432/klaros
# Alembic (and backend/scripts/db/provision_app_role.py) use this URL, not
# DATABASE_URL — it must point at the schema-owning role.
DATABASE_MIGRATION_URL=postgresql+asyncpg://klaros:klaros@postgres:5432/klaros

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Event bus transport: "redis" (production) or "memory" (dev/test
# fallback when no Redis is reachable — a real in-process transport, not a
# mock; see backend/app/events/transport.py) ---
EVENT_TRANSPORT=redis

# --- Rate limiting (public lead intake, public quote/contract views, auth,
# inbound Twilio webhooks): "memory" (dev/test default, single-process
# only) or "redis" (production — shared across every backend replica; see
# backend/app/core/rate_limit.py). Never auto-detected. ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_PUBLIC_LEAD_PER_MINUTE=10
RATE_LIMIT_PUBLIC_QUOTE_PER_MINUTE=30
RATE_LIMIT_PUBLIC_CONTRACT_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=120

# --- Auth ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Integration credential encryption (Phase 12D) ---
# Encrypts tenant-owned integration credentials at rest (OAuth tokens,
# per-tenant API keys stored in integration_connections.encrypted_credential
# — see backend/app/integrations/credential_store.py). Falls back to an
# insecure, publicly-known key when unset — the app refuses to boot with
# ENV=production if this is still unset. Set a real random value before
# storing any real tenant credential.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
# Phase 13: where the backend redirects the browser back to after a
# provider OAuth callback completes (QuickBooks, ...).
FRONTEND_BASE_URL=http://localhost:3000

# --- Object storage (S3-compatible) ---
# Leave OBJECT_STORAGE_ENDPOINT blank to use the real, working local-disk
# adapter (backend/app/storage/local_adapter.py, INTERNAL LOCAL STORAGE —
# not a mock) for job photos/documents/voice-notes. Set it to switch to a
# real S3-compatible bucket (not implemented yet — reports NOT_CONNECTED).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=klaros-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
STORAGE_LOCAL_ROOT=./storage_data

# --- Temporal ---
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=klaros-tasks

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
# Third-party integrations (leave blank until connected — the
# app shows a "Not connected" state per integration until then;
# nothing is faked as working without real credentials).
#
# As of Phase 12C, STRIPE_*/TWILIO_*/SENDGRID_*/OPENAI_API_KEY/
# ANTHROPIC_API_KEY connect to REAL, working API clients the moment
# they're set (and the process restarts) — see INTEGRATIONS.md for
# exactly what each one does and how to verify it. As of Phase 13,
# QUICKBOOKS_CLIENT_ID/SECRET/REDIRECT_URI connect the real OAuth2
# app used for the tenant-scoped QuickBooks connect flow. As of Phase
# 14, GOOGLE_CLIENT_ID/SECRET/REDIRECT_URI do the same for the
# tenant-scoped Google Calendar connect flow (see INTEGRATIONS.md for
# both) — every OTHER provider below (Xero, Google Ads, Meta Ads,
# Google Business, ServiceTitan, Jobber) is still an honest stub
# regardless of what you set here.
# ============================================================
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Phase 13: must exactly match the redirect URI registered in the
# Intuit developer app. ENVIRONMENT selects sandbox vs. production
# QuickBooks API base URLs.
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_TIMEOUT_SECONDS=20.0
QUICKBOOKS_MAX_RETRIES=3
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Stripe: real payments/refunds (app/integrations/stripe_client.py).
# STRIPE_WEBHOOK_SECRET comes from the Dashboard's webhook endpoint
# config, or `stripe listen` for local dev. This is the PLATFORM-level
# key (shared across tenants who haven't connected their own) — a tenant
# can alternatively connect their own Stripe account via Settings ->
# Integrations (Phase 12F, stored encrypted, no env var involved).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Phase 12F: previously hardcoded (20s timeout, 3 retries).
STRIPE_TIMEOUT_SECONDS=20.0
STRIPE_MAX_RETRIES=3
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Phase 14: real Google Calendar OAuth2 app — a separate Google Cloud
# OAuth client from GOOGLE_ADS_*/GOOGLE_BUSINESS_* above (this project's
# one-app-per-integration convention). REDIRECT_URI must exactly match
# the URI registered in that Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_TIMEOUT_SECONDS=20.0
GOOGLE_CALENDAR_MAX_RETRIES=3
META_ADS_APP_ID=
META_ADS_APP_SECRET=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Twilio: real SMS send + delivery-status webhook
# (app/communications/twilio_adapter.py). TWILIO_FROM_NUMBER must be a
# real Twilio number in E.164 format, e.g. +15551234567.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# SendGrid: real email send (app/communications/sendgrid_adapter.py).
# SENDGRID_FROM_EMAIL must be a sender identity you've verified in the
# SendGrid dashboard — SendGrid rejects sends from an unverified address.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- AI provider selection (Phase 9). "auto" (default) uses Anthropic if
# ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else the
# deterministic (non-AI) path — never fake AI without a real, working key.
# "deterministic" forces the safe path even if keys are present. ---
AI_PROVIDER=auto
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o-mini
# Phase 12E: previously hardcoded (20s timeout, 2 retries, 1024 max output
# tokens) — now configurable per environment. See INTEGRATIONS.md.
OPENAI_TIMEOUT_SECONDS=20.0
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1024
ANTHROPIC_TIMEOUT_SECONDS=20.0
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_MAX_OUTPUT_TOKENS=1024

# --- Knowledge-layer embeddings / RAG (Phase 3 — see
# backend/app/services/embedding_provider.py). "auto" (default) uses real
# OpenAI embeddings only if OPENAI_API_KEY is set above, else HONESTLY
# reports NOT_CONFIGURED to every search/ask call — it never silently
# substitutes a fake vector for real tenant usage. "deterministic" is a
# TEST-ONLY bag-of-words double (no external call, no real semantic
# meaning) — the test suite opts into it explicitly; never set this in a
# real deployment. There is no Anthropic embedding option: Anthropic has
# no native embeddings API. ---
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_CHUNK_SIZE_CHARS=800
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
KNOWLEDGE_SEARCH_TOP_K=5
KNOWLEDGE_SEARCH_SCORE_THRESHOLD=0.15

# --- AI Voice Receptionist (Phase 4 — see
# backend/app/services/speech_provider.py). Requires TWILIO_AUTH_TOKEN
# above (real inbound-call webhook signature verification) plus BOTH of
# these for real calls to be transcribed/spoken back — without them, a
# call honestly ends in a handoff rather than a fabricated resolution.
# "deterministic" is TEST-ONLY, same rule as EMBEDDING_PROVIDER. ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
STT_PROVIDER=auto
TTS_PROVIDER=auto
SPEECH_TIMEOUT_SECONDS=20.0
VOICE_MAX_TURNS_PER_CALL=20
VOICE_MEDIA_STREAM_IDLE_TIMEOUT_SECONDS=30.0
# Phase 6: real-time silence/turn-taking policy (see
# backend/app/services/voice_realtime_service.py) — counted in "ticks" of
# inbound Twilio media frames (~20ms of audio each), not wall-clock
# seconds, so behavior is deterministic and testable.
VOICE_SILENCE_RMS_THRESHOLD=150.0
VOICE_SILENCE_PROMPT_AFTER_TICKS=15
VOICE_SILENCE_HANGUP_AFTER_PROMPTS=2
VOICE_UTTERANCE_END_SILENCE_TICKS=8
