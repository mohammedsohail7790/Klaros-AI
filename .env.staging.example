# Staging environment overlay — Phase 0
# (KLAROS_PHASE_0_IMPLEMENTATION_PLAN.md §0.5, "Staging environment").
#
# This is NOT a second full copy of .env.example. It documents only what
# staging changes relative to .env.example's defaults — start from
# .env.example, then apply everything below. This file's purpose is
# environment SEPARATION, not a new deployment: no staging deployment
# manifest is decided in Phase 0 (the plan explicitly flags the managed-
# PaaS-vs-self-hosted platform choice as UNKNOWN — REQUIRES DECISION,
# out of scope for this file). Use this to run staging via the existing
# `docker-compose.yml` + `docker-compose.prod.yml` overlay on whatever
# host/VM you point it at, until that platform decision is made.
#
# THE ONE RULE THIS FILE EXISTS TO ENFORCE: staging must never resolve to
# a production database, a production Stripe/Twilio/SendGrid/QuickBooks/
# Google account, or a production JWT_SECRET / INTEGRATION_CREDENTIAL_
# ENCRYPTION_KEY. Every credential below is either a dedicated staging
# resource or that provider's own sandbox/test mode — never "the same one
# production uses, just also used here."

# --- Core ---
# ENV=staging (not "production") is what gates behavior in code — see
# backend/app/main.py::_assert_production_secrets_are_real, extended in
# this Phase 0 pass to also refuse to boot with the default JWT_SECRET /
# INTEGRATION_CREDENTIAL_ENCRYPTION_KEY when ENV=staging, exactly like
# production. Interactive API docs (/docs, /redoc) remain enabled under
# ENV=staging, same as development — an existing, deliberate choice this
# Phase 0 pass did not change (see that file's own comment). If staging
# becomes reachable from outside a trusted network, revisit that.
ENV=staging

# --- Database: a DEDICATED staging Postgres instance/database, never a
# read replica or snapshot of the production database. See "Seed /
# migration / reset strategy" below for how staging gets its own data. ---
DATABASE_URL=postgresql+asyncpg://klaros_staging:CHANGE_ME@<staging-postgres-host>:5432/klaros_staging

# --- Redis: a DEDICATED staging instance — never shared with production
# (shared Redis would let a staging bug's event/rate-limit traffic
# interfere with real tenant traffic, and vice versa). ---
REDIS_URL=redis://<staging-redis-host>:6379/0
EVENT_TRANSPORT=redis
RATE_LIMIT_BACKEND=redis

# --- Auth / credential encryption: generate real, random, STAGING-ONLY
# values — never reuse production's. A leaked staging secret must not
# compromise production, and vice versa. ---
JWT_SECRET=<generate-a-real-random-staging-only-secret>
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=<generate-a-real-random-staging-only-key>

# --- Third-party integrations: sandbox/test-mode credentials only.
# Every provider below that has an explicit sandbox/test mode MUST use
# it in staging; providers without one are left BLANK in staging (the
# app already handles unset credentials honestly — "Not connected" — see
# .env.example's own comment on this) rather than pointed at a real
# production-linked account. ---
#
# Stripe: use a Stripe TEST MODE secret key (sk_test_...) and a test-mode
# webhook secret from `stripe listen` or a test-mode Dashboard endpoint.
# Never a live key (sk_live_...) in staging.
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_test_CHANGE_ME
#
# QuickBooks: QUICKBOOKS_ENVIRONMENT=sandbox uses Intuit's own sandbox
# company/API base URL — see backend/app/core/config.py. Use a sandbox
# app's client ID/secret, not the production Intuit app's.
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CLIENT_ID=CHANGE_ME_SANDBOX_CLIENT_ID
QUICKBOOKS_CLIENT_SECRET=CHANGE_ME_SANDBOX_CLIENT_SECRET
#
# Twilio/SendGrid/OpenAI/Anthropic/Google/QuickBooks-adjacent providers
# with no first-class "sandbox" flag: either (a) leave blank in staging
# (recommended default — staging then honestly reports "Not connected"
# for that feature, exactly like an unconfigured dev box) or (b) use a
# provider account/number/sender explicitly designated for
# testing/staging use by your organization, never the production
# account. Document which one you chose per-provider when you actually
# stand up a staging deploy — this file intentionally does not decide
# that for every provider, since it depends on what each provider
# actually offers (KLAROS_ARCHITECTURE_RECONCILIATION.md item #6 records
# the equivalent open question for object-storage encryption-at-rest).

# --- Object storage: a dedicated staging bucket/local path — never the
# production bucket (would risk staging test uploads mixing with real
# tenant documents, or a staging bug writing/deleting production files). ---
STORAGE_LOCAL_ROOT=/var/klaros-staging/storage
OBJECT_STORAGE_BUCKET=klaros-staging-documents

# --- Migration / seed / reset strategy for staging (Phase 0 decision,
# recorded here since there is no other staging-specific doc yet) ---
# Migrations: staging runs the exact same `alembic upgrade head` this
#   Phase 0's CI pipeline already validates against a real Postgres (see
#   .github/workflows/ci.yml) — staging is the first REAL topology that
#   migration validation stage exists to de-risk before it ever runs
#   against production.
# Seed data: staging starts EMPTY and is seeded only through the
#   application's own real signup/register flow (POST /api/v1/auth/register)
#   plus ordinary use — never a database dump imported from anywhere,
#   and never production data, sanitized or otherwise (no sanitization
#   tool is built in Phase 0 — KLAROS_ARCHITECTURE_RECONCILIATION.md's
#   "avoid duplicate engines" discipline applies equally to "avoid
#   building a data-copy tool before anyone has decided it's needed").
# Reset: staging is disposable by definition (per the Phase 0 plan's own
#   "Done when" criterion) — resetting it means dropping and recreating
#   the staging database and re-running `alembic upgrade head`, never a
#   partial/manual cleanup script.
